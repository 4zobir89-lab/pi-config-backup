{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifactId",
    "name",
    "kind",
    "owner",
    "status",
    "createdAt",
    "contentHash"
  ],
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "superseded"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
