{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "knowledgeId",
    "source",
    "kind",
    "content",
    "confidence",
    "updatedAt"
  ],
  "properties": {
    "knowledgeId": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "best-practice",
        "documentation",
        "pattern",
        "anti-pattern"
      ]
    },
    "content": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
