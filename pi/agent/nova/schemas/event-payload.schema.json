{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nova/event-payload.schema.json",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "projectId",
    "occurredAt",
    "actor",
    "payloadVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "payloadVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "correlationId": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
