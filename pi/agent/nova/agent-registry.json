      "plugin": "plugins/discovery",
      "status": "enabled",
      "inputContract": "schemas/discovery.input.schema.json",
      "outputContract": "schemas/discovery.output.schema.json"
    },
    {
      "id": "requirements",
      "name": "Requirements Agent",
      "role": "تحويل الفكرة إلى متطلبات قابلة للتحقق",
