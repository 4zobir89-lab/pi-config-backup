      "category": "coordination",
      "plugin": "plugins/orchestrator",
      "status": "enabled",
      "inputContract": "schemas/orchestrator.input.schema.json",
      "outputContract": "schemas/orchestrator.output.schema.json"
    },
    {
      "id": "discovery",
      "name": "Discovery Agent",
      "role": "فهم الهدف والسياق والقيود",
