{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.0.0",
  "system": "nova",
  "description": "Portable plugin registry for Pi's Nova-compatible operating model.",
  "orchestrator": "orchestrator",
