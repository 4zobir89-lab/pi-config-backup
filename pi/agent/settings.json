  "aow": {
    "enabled": true,
    "advisorModel": "gpt-5.6-sol",
    "workerModel": "gpt-5.4-mini",
    "orchestratorModel": "gpt-5.6-sol",
    "maxWorkersPerWave": 3,
    "minAdvisorConsults": 2,
    "retryOnFailure": 1,
    "workerIsolation": true
  },
  "echo": {
    "enabled": true,
    "noActionUntilApproved": true,
    "quarantineInferences": true,
    "flagReversals": true,
    "preserveTangents": true
  },
  "selfEval": {
    "enabled": true,
    "tier1_structural": true,
    "tier2_securityDeterminism": true,
    "tier3_triggerRouting": true,
    "tier4_behavioral": true,
    "beforeDelivery": [
      "tier1",
      "tier2"
    ],
    "afterComplex": [
      "tier1",
      "tier2",
      "tier3"
    ],
    "endOfSession": [
      "tier4",
      "growth-log"
    ]
  },
  "intentVerification": {
    "enabled": true,
    "singleSentenceIntent": true,
    "compareWithChanges": true,
    "decisions": [
      "keep",
      "split",
      "justify",
      "revert"
    ]
  },
  "alwaysOn": {
    "enabled": true,
    "singleTaskPerAgent": true,
    "reportsUnder30s": true,
    "noEditWithoutPermission": true,
    "sessionLogging": true
  },
  "testing": {
    "minimumCoverage": 80,
    "enforceTDD": true,
    "requireUnitTests": true,
    "requireIntegrationTests": true,
    "requireE2ETests": true
  },
  "quality": {
    "maxFunctionLines": 50,
    "maxFileLines": 800,
    "maxNestingLevels": 4,
    "noHardcodedValues": true,
    "immutablePatterns": true
  },
  "commits": {
    "format": "conventional",
    "types": [
      "feat",
      "fix",
      "refactor",
      "docs",
      "test",
      "chore",
      "perf",
      "ci"
    ]
  },
  "instructions": {
    "loadOnStart": true,
    "files": [
      "$PI_HOME/agent/AGENTS.md",
      "$PI_HOME/agent/ECC-ENFORCEMENT.md"
    ]
  },
  "defaultThinkingLevel": "high",
  "nova": {
    "enabled": true,
    "version": "1.0.0",
    "registry": "nova/agent-registry.json",
    "events": "nova/events.json",
    "workflow": "nova/workflow.json",
    "artifactCatalog": "nova/artifact-catalog.json",
    "permissions": "nova/permissions.json",
    "defaultDeny": true,
    "requireArtifactBeforeTransition": true,
    "requireApprovalForExternalWrites": true
  }
}
