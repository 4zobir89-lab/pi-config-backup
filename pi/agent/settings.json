{
  "lastChangelogVersion": "0.84.2",
  "theme": "dark",
  "defaultProvider": "freemodel",
  "defaultModel": "gpt-5.4-mini",
  "providerPriority": [
    "freemodel",
    "dahl",
    "nvidia",
    "cloudflare-workers-ai"
  ],
  "ecc": {
    "enabled": true,
    "version": "2.2.0",
    "strictMode": true,
    "autoDelegation": true,
    "tddEnforced": true,
    "securityFirst": true,
    "immutableData": true,
    "contextAware": true,
    "swarmEnabled": true,
    "selfImprovementEnabled": true,
    "crossSessionLearning": true,
    "smartModelRouting": true,
    "xmlPromptArchitecture": true,
    "stopReviewGate": true,
    "adversarialReview": true,
    "agentForwardingRules": true,
    "structuredOutputContracts": true,
    "aowPattern": true,
    "echoProtocol": true,
    "selfEvaluation4Tier": true,
    "intentVsOutput": true,
    "alwaysOnAgents": true,
    "mcpIntegration": true,
    "ragPatterns": true,
    "enforcementFiles": [
      "AGENTS.md",
      "ECC-ENFORCEMENT.md"
    ]
  },
  "agentDefaults": {
    "usePlannerForComplex": true,
    "useTddGuideForNewFeatures": true,
    "useCodeReviewerAfterEdit": true,
    "useSecurityReviewerForSensitive": true,
    "useParallelExecution": true,
    "useCompactAtThreshold": true,
    "useCrossSessionMemory": true,
    "routeModelByTask": true,
    "useStructuredPrompts": true,
    "useStopReviewGate": true,
    "useAdversarialReview": true,
    "cleanAgentForwarding": true,
    "useAOWPattern": true,
    "useEchoProtocol": true,
    "useSelfEvaluation": true,
    "useIntentVerification": true,
    "useAlwaysOnMonitoring": true,
    "useMCPIntegration": true,
    "useRAGPatterns": true
  },
  "context": {
    "compactThreshold": 30,
    "criticalThreshold": 15,
    "emergencyThreshold": 5,
    "compactEveryNTurns": 8,
    "monitorContinuously": true
  },
  "promptEngine": {
    "useXmlArchitecture": true,
    "promptContracts": [
      "structured_output_contract",
      "compact_output_contract",
      "default_follow_through_policy",
      "completeness_contract",
      "verification_loop",
      "grounding_rules",
      "action_safety",
      "missing_context_gating",
      "dig_deeper_nudge",
      "research_mode",
      "citation_rules"
    ]
  },
  "stopGate": {
    "enabled": true,
    "reviewLastTurn": true,
    "blockOnCriticalIssues": true,
    "allowOnNoChanges": true
  },
  "adversarialReview": {
    "enabled": true,
    "attackSurface": [
      "auth",
      "data-loss",
      "rollback",
      "race-conditions",
      "empty-state",
      "timeouts",
      "stale-state"
    ],
    "requireEvidence": true,
    "outputSchema": "file:line:confidence:recommendation"
  },
  "agentForwarding": {
    "thinWrapper": true,
    "singleInvocation": true,
    "returnRawOutput": true,
    "noFollowUp": true,
    "noAnalysis": true
  },
  "swarm": {
    "enabled": true,
    "maxParallelAgents": 4,
    "requireCoordinator": true,
    "isolateWorktrees": true,
    "autoMergeAfterReview": true
  },
  "memory": {
    "sessionEndCapture": true,
    "enableInstincts": true,
    "enableADRs": true,
    "enableGrowthLogs": true
  },
  "modelRouting": {
    "enabled": true,
    "defaultProvider": "freemodel",
    "fallbackProvider": "freemodel",
